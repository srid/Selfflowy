# Belt-and-braces: never commit personal outline data if someone
# accidentally drops a copy in the repo. Canonical data is outside:
# $SELFFLOWY_HOME (default ~/Dropbox/Selfflowy-Srid/).
/private/
/Tasks.rkt
/Daily.rkt
/Roadmap.rkt

# Racket
compiled/
*.zo
*.dep

# Nix
/result
/result-*
.direnv/

# Local Racket user home for nix/dev
.plt-user/

# npm only ever runs here to regenerate acp/package-lock.json; the tree it
# leaves behind is nix's business, not the repo's.
/acp/node_modules/

/.direnv

# Agent scratch worktrees
/.claude/
